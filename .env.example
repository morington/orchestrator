DEV=false

# --- Storage -------------------------------------------------------------
# backend: postgresql | sqlite | memory
STORAGE__BACKEND=postgresql
STORAGE__PAYLOAD_INLINE_MAX=262144

# Используются оркестратором, миграциями и контейнером postgres в docker-compose
POSTGRESQL__HOST=postgres
POSTGRESQL__PORT=5432
POSTGRESQL__USERNAME=orchestrator
POSTGRESQL__PASSWORD=orchestrator
POSTGRESQL__DATABASE=orchestrator

# --- NATS ----------------------------------------------------------------
NATS__SERVERS=["nats://nats:4222"]
NATS__STREAM=ORCHESTRATOR
NATS__DURABLE_PREFIX=orchestrator
NATS__CONNECT_TIMEOUT=5
NATS__PUBLISH_TIMEOUT=5
NATS__ACK_WAIT=60

# --- Subjects ------------------------------------------------------------
SUBJECTS__WORKFLOW_START=orchestrator.workflow.start
SUBJECTS__RESULTS=orchestrator.results
SUBJECTS__WORKFLOW_COMPLETED=orchestrator.workflow.completed
SUBJECTS__WORKFLOW_CANCEL=orchestrator.workflow.cancel
SUBJECTS__ADMIN_PREFIX=orchestrator.admin
SUBJECTS__DEADLETTER=orchestrator.deadletter

# --- Engine --------------------------------------------------------------
ENGINE__REPLICA_ID=orchestrator-1
ENGINE__LEASE_TTL_SEC=30
ENGINE__OUTBOX_BATCH=50
ENGINE__SCHEDULER_BATCH=50
ENGINE__OUTBOX_POLL_SEC=1.0
ENGINE__TIMEOUT_POLL_SEC=5.0
ENGINE__ALLOWED_TARGET_PREFIXES=["service.","meta."]

# --- Retention -----------------------------------------------------------
RETENTION__WORKFLOW_DAYS=90
RETENTION__OUTBOX_DAYS=7
RETENTION__INBOX_DAYS=30
RETENTION__DLQ_DAYS=90
RETENTION__POLL_SEC=3600

# --- oopsys --------------------------------------------------------------
OOPSYS_AGENT__ENABLED=false
OOPSYS_AGENT__HOST=127.0.0.1
OOPSYS_AGENT__PORT=8080
OOPSYS_AGENT__PATH=/agents/ingest
