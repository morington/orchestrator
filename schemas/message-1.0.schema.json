{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morington/orchestrator/schemas/message-1.0.schema.json",
  "title": "Invoke envelope 1.0",
  "description": "Wire envelope published by the orchestrator to a service target (meta.target).",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_version", "definition_key", "run_id", "node_key", "step_run_id", "attempt", "data"],
  "properties": {
    "message_version": {"type": "string", "const": "1.0"},
    "definition_key": {"type": "string"},
    "run_id": {"type": "string"},
    "node_key": {"type": "string"},
    "step_run_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "transport_mode": {"enum": ["async_result_subject", "request_reply", "fire_and_forget"]},
    "reply_subject": {"type": ["string", "null"]},
    "data": {"type": "object"}
  }
}
