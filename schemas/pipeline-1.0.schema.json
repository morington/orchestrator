{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morington/orchestrator/schemas/pipeline-1.0.schema.json",
  "title": "WorkflowDefinition 1.0",
  "description": "Public DSL of a workflow definition (variant A: workflow = definition).",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition_key", "idempotency_key", "steps"],
  "properties": {
    "pipeline_version": {"type": "string", "const": "1.0"},
    "definition_key": {"type": "string", "minLength": 1},
    "business_ref": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/output"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "output": {
      "oneOf": [
        {"type": "string", "pattern": "^\\$"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {"type": "string", "pattern": "^\\$"},
            "required": {"type": "boolean"},
            "default": {}
          }
        }
      ]
    },
    "dependsOn": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node"],
          "properties": {
            "node": {"type": "integer", "minimum": 1},
            "policy": {"enum": ["requires_success", "requires_closed", "optional"]}
          }
        }
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "dispatch_timeout_sec": {"type": "integer", "minimum": 1},
        "result_wait_timeout_sec": {"type": "integer", "minimum": 1},
        "request_timeout_sec": {"type": "integer", "minimum": 1},
        "backoff_sec": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "retryable": {"type": "array", "items": {"type": "string"}}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "transport_mode": {"enum": ["async_result_subject", "request_reply", "fire_and_forget"]},
        "retry_policy": {"$ref": "#/$defs/retryPolicy"},
        "on_failure": {"enum": ["fail", "skip", "abandon"]},
        "valid_for_sec": {"type": ["integer", "null"], "minimum": 1},
        "default": {"enum": ["go", "skip"]}
      }
    },
    "filter": {
      "type": "object",
      "required": ["filter_id", "condition", "then"],
      "properties": {
        "filter_id": {"type": "integer", "minimum": 1},
        "condition": {"type": "string"},
        "then": {"enum": ["skip", "goto", "end", "error"]},
        "targets": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1}
      }
    },
    "middlewareMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {"type": "object"},
        "remove": {"type": "array", "items": {"type": "string"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "meta"],
      "properties": {
        "step_id": {"type": "integer", "minimum": 1},
        "meta": {"$ref": "#/$defs/meta"},
        "depends_on": {"type": ["array", "null"], "items": {"$ref": "#/$defs/dependsOn"}},
        "data": {"type": "object"},
        "filters": {"type": ["array", "null"], "items": {"$ref": "#/$defs/filter"}},
        "middlewares": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "before": {"$ref": "#/$defs/middlewareMeta"},
            "after": {"$ref": "#/$defs/middlewareMeta"}
          }
        }
      }
    }
  }
}
